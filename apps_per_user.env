# Flexera / Snow Atlas - Applications per user report settings.
# Keep this file private - it holds your API credentials.

CLIENT_ID=PASTE_CLIENT_ID_HERE
CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE
REGION=westeurope

# ------------------------------------------------------------------
# Filters. All text filters are "contains", case-insensitive.
# Use commas for several values:  VENDOR_INCLUDE=Microsoft,Adobe
# INCLUDE = keep only rows matching ANY value (empty = keep all)
# EXCLUDE = drop rows matching ANY value     (empty = drop none)
# ------------------------------------------------------------------
VENDOR_INCLUDE=Microsoft
VENDOR_EXCLUDE=

# Publisher: matched against the app's "publisher" field if Flexera
# returns one; otherwise falls back to the vendor field.
PUBLISHER_INCLUDE=
PUBLISHER_EXCLUDE=

APPLICATION_INCLUDE=
APPLICATION_EXCLUDE=

# Discovery types (numbers, comma-separated). Matched against the
# sources where each USER was detected for that application.
#   0 SaaS connector | 1 Manually added | 2 Browser unverified | 3 SSO
#   4 Device         | 7 Browser verified | 8 CASB
# INCLUDE: keep user-app rows found via ANY of these types
# EXCLUDE: drop user-app rows found via ANY of these types
DISCOVERY_TYPE_INCLUDE=
DISCOVERY_TYPE_EXCLUDE=

# ------------------------------------------------------------------
# Output and tuning
# ------------------------------------------------------------------
OUTPUT_FILE=ApplicationsPerUser.csv

# Speed. Threads fetch pages in parallel; one shared limiter caps the
# total requests per second across all threads. If Flexera returns a
# rate limit (HTTP 429) the script pauses every thread, slows down, then
# speeds back up on its own - so you can leave these as they are.
MAX_WORKERS=8
MAX_REQUESTS_PER_SECOND=6

# Seconds to wait for one API response before retrying it.
REQUEST_TIMEOUT=60

# Reuse HTTPS connections (faster). Falls back automatically if your
# network blocks it; set to false to force standard requests.
KEEP_ALIVE=true
