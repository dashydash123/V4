# ===================== DocuSign =====================
DS_ENV=production
DS_INTEGRATION_KEY=PASTE_HERE
DS_CLIENT_SECRET=PASTE_HERE
# current refresh token - the script replaces this line itself whenever DocuSign rotates it
DS_REFRESH_TOKEN=PASTE_HERE
# leave blank - filled in and kept up to date by the script
DS_ACCESS_TOKEN=
DS_ACCESS_TOKEN_EXPIRES_UTC=
DS_ACCOUNT_ID=PASTE_HERE
DS_START_DATE=2025-05-01
DS_COUNT_MODE=fast
DS_TZ_OFFSET=+00:00
DS_FROM_TO_STATUS=created
DS_REBUILD=0
DS_TIMEOUT=180
DS_OUTPUT_FILE=docusign_envelope_usage.xlsx

# ===================== Entitlement + results =====================
DS_TOTAL_ENVELOPES=339800
# total = all envelopes | exclude_drafts = all minus unsent drafts (status Created)
DS_CONSUMED_BASIS=total
# written by the script after every run
DS_ENVELOPES_CONSUMED=
DS_ENVELOPES_REMAINING=
DS_LAST_COUNTED_UTC=

# ===================== Flexera =====================
FLEXERA_TOKEN_URL=PASTE_HERE
FLEXERA_CLIENT_ID=PASTE_HERE
FLEXERA_CLIENT_SECRET=PASTE_HERE
FLEXERA_API_BASE=https://snowatlas-westeurope.flexera.eu
DS_SUBSCRIPTION_ID=74aeb669-b626-4111-b00f-dd92f676386d
DS_FIELD_TOTAL=Total Envelops
DS_FIELD_CONSUMED=Envelops Consumed
DS_FIELD_REMAINING=Envelops Remaining
# yes = do not write to Flexera, No = write
DS_DRY_RUN=yes

# ===================== Run / output =====================
RUN_STEPS=docusign,flexera
OUTPUT_DIR=output
LOG_MAX_MB=5
